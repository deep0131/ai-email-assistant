# =========================================
# AI Email Assistant — Environment Variables
# =========================================
# Copy this file to .env and fill in values.
# Each service also has its own .env.example.
# =========================================

# --- Frontend (Next.js) ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- Backend (Spring Boot) ---
SERVER_PORT=8080
DATABASE_URL=jdbc:postgresql://localhost:5432/ai_email_assistant
AI_SERVICE_URL=http://localhost:8000

# --- AI Service (Python) ---
AI_SERVICE_PORT=8000
# OPENAI_API_KEY=sk-...   # add when AI features are implemented
